<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_proc_cms_policy_document_tree" model="ir.ui.view">
        <field name="name">proc.cms.policy.document.tree</field>
        <field name="model">proc.cms.policy.document</field>
        <field name="arch" type="xml">
            <list class="proc-cms-page-list" decoration-muted="active == False">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="file_filename" optional="show"/>
                <field name="is_published" widget="boolean_toggle"/>
                <field name="active" widget="boolean_toggle"/>
                <field name="website_id" groups="website.group_multi_website" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="view_proc_cms_policy_document_form" model="ir.ui.view">
        <field name="name">proc.cms.policy.document.form</field>
        <field name="model">proc.cms.policy.document</field>
        <field name="arch" type="xml">
            <form string="RFQ policy document" class="proc-cms-form">
                <sheet>
                    <widget name="web_ribbon" title="Unpublished" bg_color="text-bg-warning" invisible="is_published"/>
                    <widget name="web_ribbon" title="Archived" bg_color="text-bg-danger" invisible="active"/>
                    <div class="oe_title proc-cms-form-title">
                        <h1><field name="name" placeholder="Policy document title"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="file_filename" invisible="1"/>
                            <field name="file" filename="file_filename" widget="binary"/>
                            <field name="sequence"/>
                        </group>
                        <group>
                            <field name="is_published" widget="boolean_toggle"/>
                            <field name="active" widget="boolean_toggle"/>
                            <field name="website_id" options="{'no_create': True}" groups="website.group_multi_website"/>
                        </group>
                    </group>
                    <label for="description" string="Summary (shown on the portal)"/>
                    <field name="description" widget="html" nolabel="1"/>
                    <p class="proc-cms-form-hint">
                        Public page: <code>/application/rfq-policy</code>
                    </p>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_proc_cms_policy_document" model="ir.actions.act_window">
        <field name="name">RFQ policy documents</field>
        <field name="res_model">proc.cms.policy.document</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
