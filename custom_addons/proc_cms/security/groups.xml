<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_proc_cms" model="ir.module.category">
        <field name="name">Procurement CMS</field>
        <field name="sequence">25</field>
    </record>

    <record model="res.groups.privilege" id="res_groups_privilege_proc_cms">
        <field name="name">Procurement CMS</field>
        <field name="category_id" ref="module_category_proc_cms"/>
    </record>

    <record id="group_proc_cms_manager" model="res.groups">
        <field name="name">CMS Manager</field>
        <field name="sequence">10</field>
        <field name="privilege_id" ref="res_groups_privilege_proc_cms"/>
        <field name="implied_ids" eval="[(4, ref('website.group_website_designer'))]"/>
        <field name="user_ids" eval="[(4, ref('base.user_admin'))]"/>
    </record>
</odoo>
