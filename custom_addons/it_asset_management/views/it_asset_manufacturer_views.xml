<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="it_asset_manufacturer_view_list" model="ir.ui.view">
        <field name="name">it.asset.manufacturer.list</field>
        <field name="model">it.asset.manufacturer</field>
        <field name="arch" type="xml">
            <list string="Manufacturers">
                <field name="name"/>
                <field name="code"/>
                <field name="website"/>
                <field name="equipment_count"/>
                <field name="active" column_invisible="True"/>
            </list>
        </field>
    </record>

    <record id="it_asset_manufacturer_view_form" model="ir.ui.view">
        <field name="name">it.asset.manufacturer.form</field>
        <field name="model">it.asset.manufacturer</field>
        <field name="arch" type="xml">
            <form string="Manufacturer">
                <sheet>
                    <field name="image_1920" widget="image" class="oe_avatar" options="{'preview_image': 'image_128'}"/>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" placeholder="e.g. Dell"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="code"/>
                            <field name="website" widget="url"/>
                        </group>
                        <group>
                            <field name="equipment_count"/>
                            <field name="active"/>
                        </group>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="it_asset_manufacturer_view_search" model="ir.ui.view">
        <field name="name">it.asset.manufacturer.search</field>
        <field name="model">it.asset.manufacturer</field>
        <field name="arch" type="xml">
            <search string="Manufacturers">
                <field name="name"/>
                <field name="code"/>
                <filter string="Archived" name="inactive" domain="[('active', '=', False)]"/>
            </search>
        </field>
    </record>

    <record id="it_asset_manufacturer_action" model="ir.actions.act_window">
        <field name="name">Manufacturers</field>
        <field name="res_model">it.asset.manufacturer</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>
