<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="it_asset_manufacturer_view_list" model="ir.ui.view">
        <field name="name">it.asset.manufacturer.list</field>
        <field name="model">it.asset.manufacturer</field>
        <field name="arch" type="xml">
            <list string="Manufacturers" class="ew-it-asset-list">
                <field name="name"/>
                <field name="code"/>
                <field name="website"/>
                <field name="equipment_count"/>
                <field name="active" column_invisible="True"/>
            </list>
        </field>
    </record>

    <record id="it_asset_manufacturer_view_form" model="ir.ui.view">
        <field name="name">it.asset.manufacturer.form</field>
        <field name="model">it.asset.manufacturer</field>
        <field name="arch" type="xml">
            <form string="Manufacturer" class="ew-it-asset-form ew-it-asset-form--manufacturer">
                <sheet>
                    <div class="ew-it-asset-top-row">
                        <div class="ew-it-asset-title-block oe_title">
                            <span class="ew-it-asset-tag-eyebrow">Manufacturer</span>
                            <label for="name" class="ew-it-asset-name-label">Name</label>
                            <h1><field name="name" placeholder="e.g. Dell" nolabel="1"/></h1>
                        </div>
                        <div class="ew-it-asset-photo-top">
                            <span class="ew-it-asset-tag-eyebrow">Logo</span>
                            <field name="image_1920" widget="image" class="oe_avatar ew-it-asset-photo"
                                options="{'preview_image': 'image_128'}"/>
                        </div>
                    </div>
                    <div class="ew-it-asset-form-grid ew-it-asset-form-grid--single">
                        <div class="ew-it-asset-form-card ew-it-asset-form-card--details">
                            <h3 class="ew-it-asset-form-card__title">
                                <i class="fa fa-building" title="Details"/> Details
                            </h3>
                            <group>
                                <group>
                                    <field name="code"/>
                                    <field name="website" widget="url"/>
                                </group>
                                <group>
                                    <field name="equipment_count"/>
                                    <field name="active"/>
                                </group>
                            </group>
                        </div>
                    </div>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="it_asset_manufacturer_view_search" model="ir.ui.view">
        <field name="name">it.asset.manufacturer.search</field>
        <field name="model">it.asset.manufacturer</field>
        <field name="arch" type="xml">
            <search string="Manufacturers">
                <field name="name"/>
                <field name="code"/>
                <filter string="Archived" name="inactive" domain="[('active', '=', False)]"/>
            </search>
        </field>
    </record>

    <record id="it_asset_manufacturer_action" model="ir.actions.act_window">
        <field name="name">Manufacturers</field>
        <field name="res_model">it.asset.manufacturer</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>
