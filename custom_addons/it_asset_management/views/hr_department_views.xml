<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="hr_department_view_form_it_asset" model="ir.ui.view">
        <field name="name">hr.department.form.it.asset</field>
        <field name="model">hr.department</field>
        <field name="inherit_id" ref="hr.view_department_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_open_it_assets"
                    type="object"
                    class="o_stat_button"
                    icon="fa-laptop"
                    groups="it_asset_management.group_it_asset_user">
                    <field name="it_asset_count" string="IT Assets" widget="statinfo"/>
                </button>
            </xpath>
        </field>
    </record>

</odoo>
