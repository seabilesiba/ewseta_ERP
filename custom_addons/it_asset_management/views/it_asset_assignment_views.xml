<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="it_asset_assignment_history_view_list" model="ir.ui.view">
        <field name="name">it.asset.assignment.history.list</field>
        <field name="model">it.asset.assignment.history</field>
        <field name="arch" type="xml">
            <list string="Assignment History" class="ew-it-asset-list">
                <field name="equipment_id"/>
                <field name="assign_date"/>
                <field name="return_date"/>
                <field name="employee_id"/>
                <field name="department_id"/>
                <field name="assigned_by"/>
                <field name="notes"/>
                <field name="company_id" groups="base.group_multi_company"/>
            </list>
        </field>
    </record>

    <record id="it_asset_assignment_history_view_form" model="ir.ui.view">
        <field name="name">it.asset.assignment.history.form</field>
        <field name="model">it.asset.assignment.history</field>
        <field name="arch" type="xml">
            <form string="Assignment History" class="ew-it-asset-form ew-it-asset-form--history">
                <sheet>
                    <div class="ew-it-asset-form-hero ew-it-asset-form-hero--compact">
                        <div class="ew-it-asset-title-block">
                            <span class="ew-it-asset-tag-eyebrow">Assignment record</span>
                            <h1><field name="equipment_id" nolabel="1"/></h1>
                        </div>
                    </div>
                    <div class="ew-it-asset-form-grid">
                        <div class="ew-it-asset-form-card ew-it-asset-form-card--details">
                            <h3 class="ew-it-asset-form-card__title">
                                <i class="fa fa-calendar" title="Dates"/> Dates
                            </h3>
                            <group>
                                <field name="assign_date"/>
                                <field name="return_date"/>
                            </group>
                        </div>
                        <div class="ew-it-asset-form-card ew-it-asset-form-card--assign">
                            <h3 class="ew-it-asset-form-card__title">
                                <i class="fa fa-user" title="Assignee"/> Assignee
                            </h3>
                            <group>
                                <field name="employee_id"/>
                                <field name="department_id"/>
                                <field name="assigned_by"/>
                                <field name="company_id" groups="base.group_multi_company"/>
                            </group>
                        </div>
                    </div>
                    <div class="ew-it-asset-form-card ew-it-asset-form-card--maint">
                        <h3 class="ew-it-asset-form-card__title">
                            <i class="fa fa-comment" title="Notes"/> Notes
                        </h3>
                        <field name="notes" nolabel="1" placeholder="Optional notes about this assignment…"/>
                    </div>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="it_asset_assignment_history_view_search" model="ir.ui.view">
        <field name="name">it.asset.assignment.history.search</field>
        <field name="model">it.asset.assignment.history</field>
        <field name="arch" type="xml">
            <search string="Assignment History">
                <field name="equipment_id"/>
                <field name="employee_id"/>
                <field name="department_id"/>
                <filter string="Open Assignments" name="open" domain="[('return_date', '=', False)]"/>
                <filter string="Returned" name="returned" domain="[('return_date', '!=', False)]"/>
                <group>
                    <filter string="Employee" name="group_employee" context="{'group_by': 'employee_id'}"/>
                    <filter string="Department" name="group_department" context="{'group_by': 'department_id'}"/>
                    <filter string="Asset" name="group_equipment" context="{'group_by': 'equipment_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="it_asset_assignment_history_action" model="ir.actions.act_window">
        <field name="name">Assignment History</field>
        <field name="res_model">it.asset.assignment.history</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="it_asset_assignment_history_view_search"/>
    </record>

</odoo>
