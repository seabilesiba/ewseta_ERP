<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="maintenance_equipment_view_form_it_asset" model="ir.ui.view">
        <field name="name">maintenance.equipment.form.it.asset</field>
        <field name="model">maintenance.equipment</field>
        <field name="inherit_id" ref="maintenance.hr_equipment_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//form" position="attributes">
                <attribute name="class" add="ew-it-asset-form" separator=" "/>
            </xpath>
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_open_assignment_history"
                    type="object"
                    class="oe_stat_button"
                    icon="fa-exchange"
                    groups="it_asset_management.group_it_asset_user">
                    <field name="assignment_history_count" string="History" widget="statinfo"/>
                </button>
                <button name="%(it_asset_management.it_asset_incident_report_action_equipment)d"
                    type="action"
                    class="oe_stat_button"
                    icon="fa-exclamation-triangle"
                    groups="it_asset_management.group_it_asset_user">
                    <field name="incident_report_count" string="Incidents" widget="statinfo"/>
                </button>
            </xpath>
            <xpath expr="//sheet" position="before">
                <header>
                    <button name="action_return_asset" string="Return Asset" type="object"
                        class="btn-secondary"
                        invisible="asset_state not in ('assigned', 'in_repair')"
                        groups="it_asset_management.group_it_asset_manager"/>
                    <button name="action_mark_in_repair" string="Mark In Repair" type="object"
                        class="btn-secondary"
                        invisible="asset_state in ('in_repair', 'disposed', 'lost')"
                        groups="it_asset_management.group_it_asset_manager"/>
                    <button name="action_mark_disposed" string="Dispose" type="object"
                        class="btn-secondary"
                        invisible="asset_state in ('disposed', 'lost')"
                        groups="it_asset_management.group_it_asset_manager"/>
                    <button name="action_mark_lost" string="Mark Lost" type="object"
                        class="btn-secondary"
                        invisible="asset_state in ('disposed', 'lost')"
                        groups="it_asset_management.group_it_asset_manager"/>
                    <field name="asset_state" widget="statusbar"
                        statusbar_visible="available,assigned,in_repair,lost,disposed"/>
                </header>
            </xpath>
            <xpath expr="//div[@class='oe_title']" position="replace">
                <div class="ew-it-asset-top-row">
                    <div class="ew-it-asset-title-block oe_title">
                        <span class="ew-it-asset-tag-eyebrow">Asset tag</span>
                        <h2 class="ew-it-asset-tag-value">
                            <field name="asset_code" readonly="1" nolabel="1"/>
                        </h2>
                        <label for="name" class="ew-it-asset-name-label">Device name</label>
                        <h1>
                            <field name="name" nolabel="1" placeholder="e.g. Dell Latitude 5420"/>
                        </h1>
                    </div>
                    <div class="ew-it-asset-photo-top">
                        <span class="ew-it-asset-tag-eyebrow">Asset photo</span>
                        <field name="image_1920" widget="image" class="oe_avatar ew-it-asset-photo"
                            options="{'preview_image': 'image_128'}"/>
                    </div>
                </div>
            </xpath>
            <xpath expr="//field[@name='employee_id']" position="attributes">
                <attribute name="invisible">equipment_assign_to != 'employee'</attribute>
            </xpath>
            <xpath expr="//field[@name='department_id']" position="attributes">
                <attribute name="invisible">equipment_assign_to != 'department'</attribute>
            </xpath>
            <xpath expr="//field[@name='equipment_assign_to']" position="attributes">
                <attribute name="widget">radio</attribute>
                <attribute name="options">{'horizontal': true}</attribute>
            </xpath>
            <xpath expr="//group[@name='service_info_group']" position="replace">
                <div class="ew-it-asset-form-grid">
                    <div class="ew-it-asset-form-card ew-it-asset-form-card--assign">
                        <h3 class="ew-it-asset-form-card__title">
                            <i class="fa fa-user" title="Assignment"/> Used by
                        </h3>
                        <group>
                            <field name="active" invisible="1"/>
                            <field name="equipment_assign_to" widget="radio" options="{'horizontal': true}"/>
                            <field name="employee_id" widget="many2one_avatar_employee"/>
                            <field name="department_id"/>
                        </group>
                    </div>
                    <div class="ew-it-asset-form-card ew-it-asset-form-card--details">
                        <h3 class="ew-it-asset-form-card__title">
                            <i class="fa fa-laptop" title="Asset"/> Asset details
                        </h3>
                        <group>
                            <field name="category_id" options="{'no_open': True}" context="{'default_company_id': company_id}"/>
                            <field name="company_id" groups="base.group_multi_company" options="{'no_create': True}"/>
                            <field name="asset_type"/>
                            <field name="manufacturer_id"/>
                            <field name="location_note"/>
                        </group>
                    </div>
                    <div class="ew-it-asset-form-card ew-it-asset-form-card--maint">
                        <h3 class="ew-it-asset-form-card__title">
                            <i class="fa fa-wrench" title="Maintenance"/> Maintenance
                        </h3>
                        <group>
                            <field name="maintenance_team_id" context="{'default_company_id': company_id}"/>
                            <field name="technician_user_id" domain="[('share', '=', False)]"/>
                            <field name="assign_date"/>
                            <field name="scrap_date" groups="base.group_no_one"/>
                        </group>
                    </div>
                </div>
            </xpath>
            <xpath expr="//page[@name='product_information']" position="after">
                <page string="IT Specs" name="it_specs">
                    <div class="ew-it-asset-form-grid">
                        <div class="ew-it-asset-form-card ew-it-asset-form-card--assign">
                            <h3 class="ew-it-asset-form-card__title">
                                <i class="fa fa-sitemap" title="Network"/> Network
                            </h3>
                            <group>
                                <field name="hostname"/>
                                <field name="mac_address"/>
                                <field name="ip_address"/>
                            </group>
                        </div>
                        <div class="ew-it-asset-form-card ew-it-asset-form-card--details">
                            <h3 class="ew-it-asset-form-card__title">
                                <i class="fa fa-microchip" title="System"/> System
                            </h3>
                            <group>
                                <field name="operating_system"/>
                                <field name="os_version"/>
                                <field name="cpu"/>
                                <field name="ram_gb"/>
                                <field name="storage_gb"/>
                            </group>
                        </div>
                    </div>
                    <div class="ew-it-asset-form-card ew-it-asset-form-card--maint" invisible="asset_type != 'software'">
                        <h3 class="ew-it-asset-form-card__title">
                            <i class="fa fa-key" title="License"/> Software license
                        </h3>
                        <group>
                            <field name="license_key"/>
                            <field name="license_expiry"/>
                        </group>
                    </div>
                </page>
                <page string="Lifecycle" name="lifecycle">
                    <div class="ew-it-asset-form-grid ew-it-asset-form-grid--single">
                        <div class="ew-it-asset-form-card ew-it-asset-form-card--details">
                            <h3 class="ew-it-asset-form-card__title">
                                <i class="fa fa-line-chart" title="Lifecycle"/> Lifecycle &amp; disposal
                            </h3>
                            <group>
                                <group>
                                    <field name="purchase_date"/>
                                    <field name="purchase_value"/>
                                    <field name="company_currency_id" invisible="1"/>
                                </group>
                                <group>
                                    <field name="disposal_date" readonly="asset_state != 'disposed'"/>
                                    <field name="disposal_reason" readonly="asset_state != 'disposed'"/>
                                </group>
                            </group>
                        </div>
                    </div>
                </page>
                <page string="Assignment History" name="assignment_history">
                    <field name="assignment_history_ids" readonly="1">
                        <list>
                            <field name="assign_date"/>
                            <field name="return_date"/>
                            <field name="employee_id"/>
                            <field name="department_id"/>
                            <field name="assigned_by"/>
                            <field name="notes"/>
                        </list>
                    </field>
                </page>
            </xpath>
        </field>
    </record>

    <record id="maintenance_equipment_view_tree_it_asset" model="ir.ui.view">
        <field name="name">maintenance.equipment.list.it.asset</field>
        <field name="model">maintenance.equipment</field>
        <field name="inherit_id" ref="maintenance.hr_equipment_view_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//list" position="attributes">
                <attribute name="class" add="ew-it-asset-list" separator=" "/>
            </xpath>
            <xpath expr="//list/field[@name='category_id']" position="replace"/>
            <xpath expr="//field[@name='name']" position="before">
                <field name="image_128" widget="image" optional="hide"/>
            </xpath>
            <xpath expr="//field[@name='name']" position="after">
                <field name="asset_code"/>
                <field name="category_id" optional="show"/>
                <field name="manufacturer_id" optional="show"/>
                <field name="hostname"/>
                <field name="asset_state" widget="badge"
                    decoration-success="asset_state == 'available'"
                    decoration-info="asset_state == 'assigned'"
                    decoration-warning="asset_state == 'in_repair'"
                    decoration-muted="asset_state == 'disposed'"
                    decoration-danger="asset_state == 'lost'"/>
                <field name="operating_system" optional="hide"/>
            </xpath>
        </field>
    </record>

    <record id="maintenance_equipment_view_kanban_it_asset" model="ir.ui.view">
        <field name="name">maintenance.equipment.kanban.it.asset</field>
        <field name="model">maintenance.equipment</field>
        <field name="inherit_id" ref="maintenance.hr_equipment_view_kanban"/>
        <field name="priority">20</field>
        <field name="arch" type="xml">
            <xpath expr="//kanban" position="attributes">
                <attribute name="class" add="ew-it-asset-kanban" separator=" "/>
            </xpath>
            <xpath expr="//kanban" position="inside">
                <field name="image_128"/>
                <field name="manufacturer_id"/>
                <field name="asset_code"/>
                <field name="asset_state"/>
                <field name="hostname"/>
            </xpath>
            <xpath expr="//t[@t-name='card']" position="replace">
                <t t-name="card" class="flex-row">
                    <aside class="me-2">
                        <field
                            name="image_128"
                            widget="image"
                            alt="Asset"
                            options="{'img_class': 'rounded object-fit-cover', 'size': [80, 80]}"
                            invisible="not image_128"
                        />
                        <div t-if="!record.image_128.raw_value"
                            class="d-flex align-items-center justify-content-center bg-100 border rounded text-muted"
                            style="width: 80px; height: 80px;">
                            <i class="fa fa-laptop fa-2x" title="No image"/>
                        </div>
                    </aside>
                    <main class="flex-grow-1">
                        <div>
                            <field name="name" class="fw-bold fs-5"/>
                            <span t-if="record.model.raw_value" class="fw-bold small"> (<field name="model"/>)</span>
                        </div>
                        <div t-if="record.asset_code.raw_value" class="text-muted small">
                            <field name="asset_code"/>
                        </div>
                        <div t-if="record.manufacturer_id.raw_value" class="text-muted small">
                            <field name="manufacturer_id"/>
                        </div>
                        <field t-if="record.serial_no.raw_value" name="serial_no"/>
                        <div t-if="record.hostname.raw_value" class="text-muted small">
                            <i class="fa fa-sitemap me-1" title="Hostname"/>
                            <field name="hostname"/>
                        </div>
                        <div t-if="!record.employee_id.raw_value and !record.department_id.raw_value" class="text-muted small">
                            Unassigned
                        </div>
                        <field t-if="record.employee_id.raw_value" name="employee_id"/>
                        <field t-if="record.department_id.raw_value" name="department_id"/>
                        <footer>
                            <span class="badge rounded-pill text-bg-secondary">
                                <field name="asset_state"/>
                            </span>
                            <div class="badge text-bg-danger" t-if="record.maintenance_open_count.raw_value">
                                <field name="maintenance_open_count"/> Request
                            </div>
                            <div class="d-flex ms-auto align-items-center">
                                <field name="activity_ids" widget="kanban_activity"/>
                                <field name="employee_id" widget="many2one_avatar_employee" class="ms-1"
                                    invisible="not employee_id"/>
                            </div>
                        </footer>
                    </main>
                </t>
            </xpath>
        </field>
    </record>

    <record id="maintenance_equipment_view_search_it_asset" model="ir.ui.view">
        <field name="name">maintenance.equipment.search.it.asset</field>
        <field name="model">maintenance.equipment</field>
        <field name="inherit_id" ref="maintenance.hr_equipment_view_search"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='name']" position="attributes">
                <attribute name="filter_domain">['|', '|', '|', '|', '|',
                    ('name', 'ilike', self), ('model', 'ilike', self), ('serial_no', 'ilike', self),
                    ('asset_code', 'ilike', self), ('hostname', 'ilike', self), ('partner_ref', 'ilike', self)]</attribute>
            </xpath>
            <xpath expr="//field[@name='category_id']" position="after">
                <field name="asset_code"/>
                <field name="hostname"/>
                <field name="asset_state"/>
                <field name="asset_type"/>
                <field name="manufacturer_id"/>
            </xpath>
            <xpath expr="//group" position="inside">
                <filter string="Manufacturer" name="group_manufacturer" context="{'group_by': 'manufacturer_id'}"/>
            </xpath>
            <xpath expr="//filter[@name='available']" position="after">
                <separator/>
                <filter string="Available" name="it_available" domain="[('asset_state', '=', 'available')]"/>
                <filter string="Assigned" name="it_assigned" domain="[('asset_state', '=', 'assigned')]"/>
                <filter string="In Repair" name="it_in_repair" domain="[('asset_state', '=', 'in_repair')]"/>
                <filter string="Disposed" name="it_disposed" domain="[('asset_state', '=', 'disposed')]"/>
                <filter string="Lost" name="it_lost" domain="[('asset_state', '=', 'lost')]"/>
            </xpath>
            <xpath expr="//group" position="inside">
                <filter string="Asset State" name="group_asset_state" context="{'group_by': 'asset_state'}"/>
                <filter string="Asset Type" name="group_asset_type" context="{'group_by': 'asset_type'}"/>
            </xpath>
        </field>
    </record>

</odoo>
