    <template id="report_ewseta_layout">
        <t t-set="company" t-value="doc.company_id or user.company_id"/>
        <div class="ewseta-report article" t-att-data-oe-model="doc and doc._name" t-att-data-oe-id="doc and doc.id">

            <div class="ewseta-header">
                <img t-if="company.logo"
                    t-att-src="image_data_uri(company.logo)"
                    t-att-alt="company.name"/>
            </div>

            <t t-out="0"/>

            <table class="ewseta-footer-bar">
                <tr>
                    <td class="ewseta-footer-orange"></td>
                    <td class="ewseta-footer-green"></td>
                    <td class="ewseta-footer-blue"></td>
                </tr>
            </table>
        </div>
    </template>

</odoo>
