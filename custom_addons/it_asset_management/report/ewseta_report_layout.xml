<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Inject EW SETA styles into PDF head (wkhtmltopdf reads CSS from head only) -->
    <template id="ewseta_report_styles_pdf" inherit_id="web.minimal_layout">
        <xpath expr="//head/meta[@charset='utf-8']" position="after">
            <style type="text/css">
                @page { margin-top: 8mm; margin-bottom: 14mm; margin-left: 12mm; margin-right: 12mm; }
                body { margin: 0; padding: 0; }
                .container, .container-fluid { padding-top: 0 !important; margin-top: 0 !important; }
                .ewseta-report { font-family: Arial, Helvetica, sans-serif; font-size: 10.5pt; color: #2b2b2b; line-height: 1.45; margin: 0; padding: 0; }
                .ewseta-report.article { margin-top: 0; padding-top: 0; }
                .ewseta-content { margin: 0; padding: 0; }
                .ewseta-header { text-align: right; margin: 0 0 6px 0; padding: 0 0 4px 0; line-height: 0; border-bottom: 2px solid #F7941D; }
                .ewseta-header img { max-height: 55px; max-width: 220px; width: auto; height: auto; display: block; margin: 0 0 0 auto; padding: 0; vertical-align: top; }
                .ewseta-title-block { text-align: center; margin: 6px 0 12px; padding: 8px 10px; border-top: none; border-bottom: 1px solid #dddddd; background-color: #fffaf5; }
                .ewseta-title-block h2 { margin: 0 0 4px; font-size: 17pt; font-weight: bold; color: #1a1a1a; }
                .ewseta-title-block .ewseta-subtitle { margin: 0; font-size: 9.5pt; color: #666666; }
                .ewseta-ref { margin: 0 0 14px; padding: 8px 12px; background-color: #f5f5f5; border-left: 4px solid #00ADEF; font-size: 11pt; }
                .ewseta-section { margin-bottom: 14px; page-break-inside: avoid; }
                .ewseta-section-title { margin: 0 0 8px; padding: 6px 10px; font-size: 11pt; font-weight: bold; color: #ffffff; background-color: #F7941D; }
                .ewseta-table { width: 100%; border-collapse: collapse; margin-bottom: 4px; background-color: #ffffff; }
                .ewseta-table td, .ewseta-table th { border: 1px solid #d9d9d9; padding: 6px 8px; vertical-align: top; }
                .ewseta-table td.label, .ewseta-table th { width: 32%; font-weight: bold; background-color: #f7f7f7; color: #333333; }
                .ewseta-check-grid td { width: 25%; font-size: 9.5pt; }
                .ewseta-check { display: inline-block; width: 13px; height: 13px; line-height: 13px; text-align: center; border: 1px solid #888888; margin-right: 5px; font-size: 9pt; font-weight: bold; }
                .ewseta-check.checked { background-color: #8DC63F; border-color: #6da82f; color: #ffffff; }
                .ewseta-note { margin: 6px 0 0; padding: 8px 10px; background-color: #fafafa; border: 1px solid #e6e6e6; border-left: 3px solid #00ADEF; }
                .ewseta-signatures td { width: 33%; vertical-align: top; }
                .ewseta-signatures .role { display: block; font-weight: bold; color: #F7941D; margin-bottom: 6px; font-size: 10pt; }
                .ewseta-signatures img { max-height: 70px; max-width: 180px; margin: 4px 0; }
                .ewseta-signatures .comment { margin-top: 6px; font-size: 9pt; color: #555555; font-style: italic; }
                .ewseta-footer-bar { width: 100%; border-collapse: collapse; margin-top: 20px; }
                .ewseta-footer-bar td { height: 7px; padding: 0; border: none; }
                .ewseta-footer-orange { width: 22%; background-color: #F7941D; }
                .ewseta-footer-green { width: 56%; background-color: #8DC63F; }
                .ewseta-footer-blue { width: 22%; background-color: #00ADEF; }
            </style>
        </xpath>
    </template>

