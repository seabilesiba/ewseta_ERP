<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record model="res.groups.privilege" id="res_groups_privilege_it_asset">
        <field name="name">IT Assets</field>
        <field name="category_id" ref="base.module_category_human_resources"/>
    </record>

    <record id="group_it_asset_user" model="res.groups">
        <field name="name">IT Asset User</field>
        <field name="sequence">10</field>
        <field name="privilege_id" ref="res_groups_privilege_it_asset"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <record id="group_it_asset_manager" model="res.groups">
        <field name="name">IT Asset Manager</field>
        <field name="sequence">20</field>
        <field name="privilege_id" ref="res_groups_privilege_it_asset"/>
        <field name="implied_ids" eval="[(4, ref('group_it_asset_user')), (4, ref('maintenance.group_equipment_manager'))]"/>
        <field name="user_ids" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
    </record>

    <record id="group_it_asset_administrator" model="res.groups">
        <field name="name">IT Asset Administrator</field>
        <field name="sequence">30</field>
        <field name="privilege_id" ref="res_groups_privilege_it_asset"/>
        <field name="implied_ids" eval="[(4, ref('group_it_asset_manager'))]"/>
    </record>

    <record id="it_asset_assignment_history_rule_company" model="ir.rule">
        <field name="name">IT Asset Assignment History: multi-company</field>
        <field name="model_id" ref="model_it_asset_assignment_history"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>

</odoo>

