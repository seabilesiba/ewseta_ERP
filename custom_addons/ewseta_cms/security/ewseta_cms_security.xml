<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record model="res.groups.privilege" id="res_groups_privilege_ewseta_cms">
        <field name="name">EWSETA Website</field>
        <field name="category_id" ref="base.module_category_website"/>
    </record>

    <record id="group_ewseta_marketing" model="res.groups">
        <field name="name">EWSETA Marketing</field>
        <field name="sequence">10</field>
        <field name="privilege_id" ref="res_groups_privilege_ewseta_cms"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user')), (4, ref('website.group_website_restricted_editor'))]"/>
    </record>

    <record id="group_ewseta_hr" model="res.groups">
        <field name="name">EWSETA HR</field>
        <field name="sequence">20</field>
        <field name="privilege_id" ref="res_groups_privilege_ewseta_cms"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user')), (4, ref('hr_recruitment.group_hr_recruitment_user'))]"/>
    </record>

    <record id="group_ewseta_supply_chain" model="res.groups">
        <field name="name">EWSETA Supply Chain</field>
        <field name="sequence">30</field>
        <field name="privilege_id" ref="res_groups_privilege_ewseta_cms"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <record id="group_ewseta_website_admin" model="res.groups">
        <field name="name">EWSETA Website Admin</field>
        <field name="sequence">40</field>
        <field name="privilege_id" ref="res_groups_privilege_ewseta_cms"/>
        <field name="implied_ids" eval="[
            (4, ref('group_ewseta_marketing')),
            (4, ref('group_ewseta_hr')),
            (4, ref('group_ewseta_supply_chain')),
            (4, ref('website.group_website_designer')),
        ]"/>
        <field name="user_ids" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
    </record>

</odoo>
