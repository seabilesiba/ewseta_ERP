<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="ewseta_rfq_view_list" model="ir.ui.view">
        <field name="name">ewseta.rfq.list</field>
        <field name="model">ewseta.rfq</field>
        <field name="arch" type="xml">
            <list string="RFQs">
                <field name="reference"/>
                <field name="name"/>
                <field name="closing_date"/>
                <field name="state" widget="badge" decoration-success="state == 'published'" decoration-muted="state == 'closed'"/>
                <field name="is_published" widget="boolean_toggle"/>
            </list>
        </field>
    </record>

    <record id="ewseta_rfq_view_form" model="ir.ui.view">
        <field name="name">ewseta.rfq.form</field>
        <field name="model">ewseta.rfq</field>
        <field name="arch" type="xml">
            <form string="RFQ">
                <header>
                    <button name="action_publish" string="Publish" type="object" class="btn-primary" invisible="state == 'published'"/>
                    <button name="action_close" string="Close" type="object" invisible="state != 'published'"/>
                    <button name="action_draft" string="Reset to Draft" type="object" invisible="state == 'draft'"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,published,closed"/>
                </header>
                <sheet>
                    <widget name="web_ribbon" title="Published" bg_color="text-bg-success" invisible="state != 'published'"/>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="reference"/>
                            <field name="closing_date"/>
                            <field name="slug"/>
                        </group>
                        <group>
                            <field name="is_published"/>
                            <field name="website_id" groups="website.group_multi_website"/>
                            <field name="website_url" widget="url"/>
                        </group>
                    </group>
                    <field name="description"/>
                    <group string="Documents">
                        <field name="attachment_ids" widget="many2many_binary"/>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="ewseta_rfq_action" model="ir.actions.act_window">
        <field name="name">RFQs</field>
        <field name="res_model">ewseta.rfq</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>
