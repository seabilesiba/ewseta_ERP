<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="ewseta_website_menu_view_list" model="ir.ui.view">
        <field name="name">website.menu.list.ewseta</field>
        <field name="model">website.menu</field>
        <field name="arch" type="xml">
            <list string="Navigation Menu" default_order="sequence,id">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="url"/>
                <field name="is_mega_menu"/>
                <field name="is_published" widget="boolean_toggle"/>
                <field name="new_window"/>
                <field name="parent_id" optional="hide"/>
                <field name="website_id" groups="website.group_multi_website"/>
            </list>
        </field>
    </record>

    <record id="ewseta_website_menu_view_form" model="ir.ui.view">
        <field name="name">website.menu.form.ewseta</field>
        <field name="model">website.menu</field>
        <field name="arch" type="xml">
            <form string="Navigation Menu Item">
                <sheet>
                    <widget name="web_ribbon" title="Published" bg_color="text-bg-success" invisible="not is_published"/>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="url" readonly="page_id or is_mega_menu or child_id"/>
                            <field name="page_id"/>
                            <field name="is_mega_menu"/>
                            <field name="is_published"/>
                        </group>
                        <group>
                            <field name="sequence"/>
                            <field name="new_window" readonly="is_mega_menu or child_id"/>
                            <field name="parent_id" domain="[('website_id', '=', website_id)]"/>
                            <field name="website_id" options="{'no_create': True}" groups="website.group_multi_website"/>
                        </group>
                    </group>
                    <group string="Mega Menu Content" invisible="not is_mega_menu">
                        <div class="alert alert-info mb-2" role="alert">
                            Use the card layout for rich dropdowns: wrap cards in
                            <code>section.ewseta-mega-menu-cards</code>, group with
                            <code>h6.ewseta-mega-section-title</code>, and each link as
                            <code>a.ewseta-nav-card</code> with
                            <code>span.ewseta-nav-card-icon</code> (plus
                            <code>ewseta-icon-orange|blue|green</code>),
                            <code>strong.ewseta-nav-card-title</code>, and
                            <code>span.ewseta-nav-card-desc</code>.
                        </div>
                        <field name="mega_menu_content" widget="html" nolabel="1"/>
                    </group>
                    <separator string="Submenu Items" invisible="is_mega_menu"/>
                    <field name="child_id" invisible="is_mega_menu">
                        <list editable="bottom">
                            <field name="sequence" widget="handle"/>
                            <field name="name"/>
                            <field name="url"/>
                            <field name="is_published" widget="boolean_toggle"/>
                            <field name="new_window"/>
                        </list>
                    </field>
                </sheet>
            </form>
        </field>
    </record>

    <record id="ewseta_website_menu_action" model="ir.actions.act_window">
        <field name="name">Navigation Menu</field>
        <field name="res_model">website.menu</field>
        <field name="view_mode">list,form</field>
        <field name="view_ids" eval="[
            (5, 0, 0),
            (0, 0, {'view_mode': 'list', 'view_id': ref('ewseta_website_menu_view_list')}),
            (0, 0, {'view_mode': 'form', 'view_id': ref('ewseta_website_menu_view_form')}),
        ]"/>
        <field name="domain">[('parent_id', '!=', False), ('parent_id.parent_id', '=', False)]</field>
        <field name="context" eval="{'default_website_id': ref('website.default_website')}"/>
    </record>

</odoo>
