<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="ewseta_news_article_view_list" model="ir.ui.view">
        <field name="name">ewseta.news.article.list</field>
        <field name="model">ewseta.news.article</field>
        <field name="arch" type="xml">
            <list string="News Articles">
                <field name="publish_date"/>
                <field name="name"/>
                <field name="is_featured"/>
                <field name="is_published" widget="boolean_toggle"/>
                <field name="website_id" groups="website.group_multi_website"/>
            </list>
        </field>
    </record>

    <record id="ewseta_news_article_view_form" model="ir.ui.view">
        <field name="name">ewseta.news.article.form</field>
        <field name="model">ewseta.news.article</field>
        <field name="arch" type="xml">
            <form string="News Article">
                <sheet>
                    <widget name="web_ribbon" title="Published" bg_color="text-bg-success" invisible="not is_published"/>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" placeholder="Article title"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="subtitle"/>
                            <field name="publish_date"/>
                            <field name="is_featured"/>
                            <field name="is_published"/>
                            <field name="slug"/>
                        </group>
                        <group>
                            <field name="featured_image" widget="image" options="{'size': [0, 0]}"/>
                            <field name="featured_image_url" placeholder="Optional fallback only if not uploading above"/>
                            <field name="website_id" groups="website.group_multi_website"/>
                            <field name="website_url" widget="url"/>
                        </group>
                    </group>
                    <field name="body"/>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="ewseta_news_article_action" model="ir.actions.act_window">
        <field name="name">News Articles</field>
        <field name="res_model">ewseta.news.article</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>
