<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="ewseta_performance_metric_view_list" model="ir.ui.view">
        <field name="name">ewseta.performance.metric.list</field>
        <field name="model">ewseta.performance.metric</field>
        <field name="arch" type="xml">
            <list string="Performance Metrics" default_order="sequence">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="value"/>
                <field name="label"/>
                <field name="progress"/>
                <field name="is_published" widget="boolean_toggle"/>
            </list>
        </field>
    </record>

    <record id="ewseta_performance_metric_view_form" model="ir.ui.view">
        <field name="name">ewseta.performance.metric.form</field>
        <field name="model">ewseta.performance.metric</field>
        <field name="arch" type="xml">
            <form string="Performance Metric">
                <sheet>
                    <widget name="web_ribbon" title="Published" bg_color="text-bg-success" invisible="not is_published"/>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="value"/>
                            <field name="label"/>
                            <field name="sequence"/>
                            <field name="is_published"/>
                        </group>
                        <group>
                            <field name="icon_class"/>
                            <field name="color"/>
                            <field name="progress"/>
                            <field name="progress_label"/>
                            <field name="website_id" groups="website.group_multi_website"/>
                        </group>
                    </group>
                    <field name="description"/>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="ewseta_performance_metric_action" model="ir.actions.act_window">
        <field name="name">Performance Metrics</field>
        <field name="res_model">ewseta.performance.metric</field>
        <field name="view_mode">list,form</field>
    </record>

    <function model="ewseta.performance.metric" name="seed_default_metrics"/>

</odoo>
