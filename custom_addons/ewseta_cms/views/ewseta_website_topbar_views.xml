<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="ewseta_website_topbar_view_list" model="ir.ui.view">
        <field name="name">ewseta.website.topbar.list</field>
        <field name="model">ewseta.website.topbar</field>
        <field name="arch" type="xml">
            <list string="Top Bar">
                <field name="name"/>
                <field name="is_active" widget="boolean_toggle"/>
                <field name="website_id" groups="website.group_multi_website"/>
            </list>
        </field>
    </record>

    <record id="ewseta_website_topbar_view_form" model="ir.ui.view">
        <field name="name">ewseta.website.topbar.form</field>
        <field name="model">ewseta.website.topbar</field>
        <field name="arch" type="xml">
            <form string="Top Bar">
                <sheet>
                    <widget name="web_ribbon" title="Active" bg_color="text-bg-success" invisible="not is_active"/>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="is_active"/>
                            <field name="website_id" groups="website.group_multi_website"/>
                        </group>
                    </group>
                    <group string="Fraud Hotline">
                        <group>
                            <field name="hotline_label"/>
                            <field name="hotline_phone"/>
                            <field name="hotline_phone_link"/>
                        </group>
                        <group>
                            <field name="hotline_meta"/>
                        </group>
                    </group>
                    <group string="Opening Hours Dropdown">
                        <group>
                            <field name="hours_menu_label"/>
                            <field name="hours_title"/>
                        </group>
                        <group>
                            <field name="hours_note"/>
                        </group>
                        <field name="hours_address" placeholder="Office address shown in the dropdown"/>
                    </group>
                    <field name="hours_line_ids">
                        <list editable="bottom">
                            <field name="sequence" widget="handle"/>
                            <field name="day_label"/>
                            <field name="time_label"/>
                            <field name="is_closed"/>
                        </list>
                    </field>
                    <separator string="Quick Links"/>
                    <field name="link_ids">
                        <list editable="bottom">
                            <field name="sequence" widget="handle"/>
                            <field name="label"/>
                            <field name="url"/>
                            <field name="icon"/>
                            <field name="is_published" widget="boolean_toggle"/>
                        </list>
                    </field>
                    <group string="Social Media">
                        <field name="social_label"/>
                    </group>
                    <field name="social_ids">
                        <list editable="bottom">
                            <field name="sequence" widget="handle"/>
                            <field name="network"/>
                            <field name="url"/>
                            <field name="label"/>
                            <field name="is_published" widget="boolean_toggle"/>
                        </list>
                    </field>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="ewseta_website_topbar_action" model="ir.actions.act_window">
        <field name="name">Top Bar</field>
        <field name="res_model">ewseta.website.topbar</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>
