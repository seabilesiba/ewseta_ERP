<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <template id="report_helpdesk_ticket_document">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="doc">
                <t t-call="web.external_layout">
                    <div class="page">
                        <div class="text-center mb-4">
                            <h2>ICT Helpdesk Ticket</h2>
                            <h3><span t-field="doc.name"/></h3>
                        </div>

                        <table class="table table-sm table-bordered">
                            <tr>
                                <td class="fw-bold" style="width: 30%;">Title</td>
                                <td><span t-field="doc.title"/></td>
                            </tr>
                            <tr>
                                <td class="fw-bold">Status</td>
                                <td><span t-field="doc.state"/></td>
                            </tr>
                            <tr>
                                <td class="fw-bold">Priority</td>
                                <td><span t-field="doc.priority"/></td>
                            </tr>
                            <tr>
                                <td class="fw-bold">Category</td>
                                <td><span t-field="doc.category_id"/></td>
                            </tr>
                            <tr>
                                <td class="fw-bold">Requester</td>
                                <td><span t-field="doc.requester_id"/></td>
                            </tr>
                            <tr>
                                <td class="fw-bold">Technician</td>
                                <td><span t-field="doc.technician_id"/></td>
                            </tr>
                            <tr>
                                <td class="fw-bold">Opened Date</td>
                                <td><span t-field="doc.opened_date"/></td>
                            </tr>
                            <tr>
                                <td class="fw-bold">Deadline</td>
                                <td><span t-field="doc.deadline"/></td>
                            </tr>
                        </table>

                        <h4 class="mt-4">Problem Description</h4>
                        <p t-field="doc.description"/>

                        <t t-if="doc.resolution">
                            <h4 class="mt-4">Resolution</h4>
                            <p t-field="doc.resolution"/>
                        </t>
                    </div>
                </t>
            </t>
        </t>
    </template>

</odoo>
