<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="helpdesk_ticket_view_list" model="ir.ui.view">
        <field name="name">helpdesk.ticket.list</field>
        <field name="model">helpdesk.ticket</field>
        <field name="arch" type="xml">
            <list string="Helpdesk Tickets" decoration-danger="is_overdue">
                <field name="name"/>
                <field name="title"/>
                <field name="requester_id" widget="many2one_avatar_user"/>
                <field name="category_id"/>
                <field name="technician_id" widget="many2one_avatar_user" optional="show"/>
                <field name="priority" widget="priority"/>
                <field name="opened_date"/>
                <field name="deadline" optional="show"/>
                <field name="is_overdue" column_invisible="True"/>
                <field name="state" widget="badge"
                    decoration-info="state == 'new'"
                    decoration-primary="state == 'assigned'"
                    decoration-warning="state == 'in_progress'"
                    decoration-success="state in ('resolved', 'closed')"
                    decoration-muted="state == 'cancelled'"/>
                <field name="company_id" groups="base.group_multi_company" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="helpdesk_ticket_view_form" model="ir.ui.view">
        <field name="name">helpdesk.ticket.form</field>
        <field name="model">helpdesk.ticket</field>
        <field name="arch" type="xml">
            <form string="Helpdesk Ticket">
                <header>
                    <button name="action_assign" string="Assign" type="object" class="btn-primary"
                        invisible="state != 'new'"
                        groups="intern_helpdesk.group_helpdesk_technician"/>
                    <button name="action_assign_to_me" string="Assign to Me" type="object" class="btn-secondary"
                        invisible="state not in ('new', 'assigned') or technician_id == uid"
                        groups="intern_helpdesk.group_helpdesk_technician"/>
                    <button name="action_start_work" string="Start Work" type="object" class="btn-primary"
                        invisible="state != 'assigned'"
                        groups="intern_helpdesk.group_helpdesk_technician"/>
                    <button name="action_resolve" string="Resolve" type="object" class="btn-primary"
                        invisible="state != 'in_progress'"
                        groups="intern_helpdesk.group_helpdesk_technician"/>
                    <button name="action_close" string="Close" type="object" class="btn-secondary"
                        invisible="state != 'resolved'"
                        groups="intern_helpdesk.group_helpdesk_manager"/>
                    <button name="action_reopen" string="Reopen" type="object" class="btn-secondary"
                        invisible="state not in ('closed', 'cancelled', 'resolved')"
                        groups="intern_helpdesk.group_helpdesk_technician"/>
                    <button name="action_cancel" string="Cancel" type="object" class="btn-secondary"
                        invisible="state in ('closed', 'cancelled')"/>
                    <field name="state" widget="statusbar"
                        statusbar_visible="new,assigned,in_progress,resolved,closed"/>
                </header>
                <sheet>
                    <field name="is_overdue" invisible="1"/>
                    <div class="alert alert-danger text-center mb-3" role="alert" invisible="not is_overdue">
                        This ticket is overdue.
                    </div>
                    <div class="oe_title">
                        <label for="title"/>
                        <h1><field name="title" placeholder="Short description of the problem" readonly="state in ('closed', 'cancelled', 'resolved')"/></h1>
                        <h3><field name="name" readonly="1"/></h3>
                    </div>
                    <group>
                        <group>
                            <field name="requester_id" widget="many2one_avatar_user" readonly="state != 'new'"/>
                            <field name="category_id"/>
                            <field name="priority" widget="priority"/>
                        </group>
                        <group>
                            <field name="technician_id" widget="many2one_avatar_user"
                                groups="intern_helpdesk.group_helpdesk_technician"/>
                            <field name="opened_date"/>
                            <field name="deadline"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Description" name="description">
                            <field name="description" placeholder="Describe the problem in detail..."
                                readonly="state in ('closed', 'cancelled')"/>
                        </page>
                        <page string="Resolution" name="resolution"
                            groups="intern_helpdesk.group_helpdesk_technician">
                            <field name="resolution" placeholder="Explain how the issue was resolved..."
                                readonly="state in ('closed', 'cancelled')"/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="helpdesk_ticket_view_search" model="ir.ui.view">
        <field name="name">helpdesk.ticket.search</field>
        <field name="model">helpdesk.ticket</field>
        <field name="arch" type="xml">
            <search string="Helpdesk Tickets">
                <field name="name"/>
                <field name="title"/>
                <field name="requester_id"/>
                <field name="technician_id"/>
                <field name="category_id"/>
                <separator/>
                <filter string="My Tickets" name="my_tickets" domain="[('requester_id', '=', uid)]"/>
                <filter string="Assigned to Me" name="assigned_to_me" domain="[('technician_id', '=', uid)]"
                    groups="intern_helpdesk.group_helpdesk_technician"/>
                <filter string="Unassigned" name="unassigned" domain="[('technician_id', '=', False), ('state', 'in', ('new', 'assigned'))]"
                    groups="intern_helpdesk.group_helpdesk_technician"/>
                <separator/>
                <filter string="New" name="state_new" domain="[('state', '=', 'new')]"/>
                <filter string="In Progress" name="state_in_progress" domain="[('state', '=', 'in_progress')]"/>
                <filter string="Resolved" name="state_resolved" domain="[('state', '=', 'resolved')]"/>
                <filter string="Closed" name="state_closed" domain="[('state', '=', 'closed')]"/>
                <filter string="Overdue" name="overdue"
                    domain="[('deadline', '&lt;', 'today'), ('state', 'not in', ('resolved', 'closed', 'cancelled'))]"/>
                <separator/>
                <filter string="Urgent" name="priority_urgent" domain="[('priority', '=', '3')]"/>
                <filter string="High" name="priority_high" domain="[('priority', '=', '2')]"/>
                <group>
                    <filter string="Status" name="group_state" context="{'group_by': 'state'}"/>
                    <filter string="Category" name="group_category" context="{'group_by': 'category_id'}"/>
                    <filter string="Technician" name="group_technician" context="{'group_by': 'technician_id'}"/>
                    <filter string="Priority" name="group_priority" context="{'group_by': 'priority'}"/>
                    <filter string="Requester" name="group_requester" context="{'group_by': 'requester_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="helpdesk_ticket_view_kanban" model="ir.ui.view">
        <field name="name">helpdesk.ticket.kanban</field>
        <field name="model">helpdesk.ticket</field>
        <field name="arch" type="xml">
            <kanban default_group_by="state" class="o_kanban_small_column" sample="1">
                <field name="name"/>
                <field name="title"/>
                <field name="requester_id"/>
                <field name="technician_id"/>
                <field name="category_id"/>
                <field name="priority"/>
                <field name="state"/>
                <field name="color"/>
                <field name="is_overdue"/>
                <field name="activity_ids"/>
                <templates>
                    <t t-name="card">
                        <field name="name" class="fw-bold"/>
                        <field name="title"/>
                        <div class="text-muted small">
                            <field name="category_id"/>
                        </div>
                        <footer class="pt-1">
                            <field name="priority" widget="priority"/>
                            <field name="technician_id" widget="many2one_avatar_user" class="ms-auto"/>
                            <field name="activity_ids" widget="kanban_activity"/>
                        </footer>
                        <span t-if="record.is_overdue.raw_value" class="badge text-bg-danger mt-1">Overdue</span>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="helpdesk_ticket_action_my" model="ir.actions.act_window">
        <field name="name">My Tickets</field>
        <field name="res_model">helpdesk.ticket</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="domain">[('requester_id', '=', uid)]</field>
        <field name="context">{'search_default_my_tickets': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Submit your first ICT support ticket
            </p>
            <p>
                Report hardware, software, network or email problems to the ICT team.
            </p>
        </field>
    </record>

    <record id="helpdesk_ticket_action_all" model="ir.actions.act_window">
        <field name="name">All Tickets</field>
        <field name="res_model">helpdesk.ticket</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="context">{}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No helpdesk tickets yet
            </p>
            <p>
                ICT support tickets appear here as employees report problems.
            </p>
        </field>
    </record>

    <record id="helpdesk_ticket_action_technician" model="ir.actions.act_window">
        <field name="name">My Assignments</field>
        <field name="res_model">helpdesk.ticket</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="domain">[('technician_id', '=', uid)]</field>
        <field name="context">{'search_default_assigned_to_me': 1}</field>
    </record>

</odoo>
