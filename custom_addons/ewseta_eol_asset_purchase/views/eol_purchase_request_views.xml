<?xml version="1.0" encoding="utf-8"?>

<odoo>



    <record id="eol_purchase_request_view_tree" model="ir.ui.view">

        <field name="name">ew.eol.purchase.request.list</field>

        <field name="model">ew.eol.purchase.request</field>

        <field name="arch" type="xml">

            <list class="ew-eol-request-list" decoration-muted="state in ('cancelled', 'rejected')"

                decoration-success="state == 'received'"

                decoration-info="state == 'approved'"

                decoration-warning="state in ('awaiting_approval', 'exception')">

                <field name="name"/>

                <field name="employee_name"/>

                <field name="work_email" optional="hide"/>

                <field name="category_id"/>

                <field name="request_type" optional="hide"/>

                <field name="state" widget="badge"

                    decoration-success="state == 'received'"

                    decoration-info="state == 'approved'"

                    decoration-warning="state in ('awaiting_approval', 'exception', 'pending_verification')"

                    decoration-danger="state == 'rejected'"

                    decoration-muted="state in ('cancelled', 'draft')"/>

                <field name="equipment_id"/>

                <field name="sale_price" widget="monetary"/>

                <field name="create_date" optional="show"/>

            </list>

        </field>

    </record>



    <record id="eol_purchase_request_view_form" model="ir.ui.view">

        <field name="name">ew.eol.purchase.request.form</field>

        <field name="model">ew.eol.purchase.request</field>

        <field name="arch" type="xml">

            <form string="EOL Purchase Request" class="ew-eol-form ew-eol-request-form">

                <header>

                    <button name="action_resend_tracking_link" string="Resend tracking link"

                        type="object" class="btn-secondary"

                        invisible="not can_resend_tracking_link"

                        confirm="A new private link will be emailed to the employee. Any previous tracking link will stop working. Continue?"/>

                    <button name="action_manual_verify_employee" string="Verify employee"

                        type="object" class="btn-primary"

                        invisible="state != 'exception' or not employee_id"

                        groups="ewseta_eol_asset_purchase.group_eol_asset_manager"/>

                    <button name="action_submit_for_approval" string="Send for approval"

                        type="object" class="btn-primary"

                        invisible="state != 'under_review'"

                        groups="ewseta_eol_asset_purchase.group_eol_asset_manager"/>

                    <button name="action_approve" string="Approve" type="object"

                        class="btn-primary" invisible="state != 'awaiting_approval'"

                        groups="ewseta_eol_asset_purchase.group_eol_approver"/>

                    <button name="action_mark_asset_received" string="Mark asset received"

                        type="object" class="btn-primary"

                        invisible="state != 'approved'"

                        confirm="This confirms the employee collected the asset. The linked equipment will be marked Sold and removed from the EOL pool. Continue?"

                        groups="ewseta_eol_asset_purchase.group_eol_asset_manager,it_asset_management.group_it_asset_manager"/>

                    <button name="action_reject" string="Reject" type="object"

                        invisible="state != 'awaiting_approval'"

                        groups="ewseta_eol_asset_purchase.group_eol_approver"/>

                    <button name="action_return_for_correction" string="Return" type="object"

                        invisible="state != 'awaiting_approval'"

                        groups="ewseta_eol_asset_purchase.group_eol_approver"/>

                    <button name="action_cancel" string="Cancel" type="object"

                        invisible="state in ('approved', 'received', 'rejected', 'cancelled')"/>

                    <field name="state" widget="statusbar"

                        statusbar_visible="under_review,awaiting_approval,approved,received"/>

                </header>

                <sheet>

                    <div class="ew-eol-form-hero">

                        <div>

                            <span class="ew-eol-form-label">Employee EOL purchase</span>

                            <div class="oe_title ew-eol-form-title">

                                <h1><field name="name" readonly="1"/></h1>

                            </div>

                        </div>

                        <div class="ew-eol-form-hero-meta">

                            <span class="ew-eol-form-label">Sale price (ZAR)</span>

                            <div class="ew-eol-form-price">

                                <field name="sale_price" widget="monetary" readonly="1" nolabel="1"/>

                            </div>

                        </div>

                    </div>

                    <div class="ew-eol-form-grid">

                        <div class="ew-eol-form-card">

                            <h3 class="ew-eol-form-card__title">

                                <i class="fa fa-user" title="Employee"/> Employee

                            </h3>

                            <group>

                                <field name="channel" readonly="1"/>

                                <field name="employee_id"/>

                                <field name="employee_name"/>

                                <field name="employee_number"/>

                                <field name="work_email" widget="email"/>

                                <field name="department_name"/>

                                <field name="site_name"/>

                                <field name="employee_verified" string="Identity verified (ICT)"/>

                                <field name="manual_verification"/>

                                <field name="can_resend_tracking_link" invisible="1"/>

                                <field name="verification_id" invisible="1"/>

                            </group>

                        </div>

                        <div class="ew-eol-form-card ew-eol-form-card--status">

                            <h3 class="ew-eol-form-card__title">

                                <i class="fa fa-laptop" title="Device"/> Device &amp; request

                            </h3>

                            <group>

                                <field name="category_id"/>

                                <field name="request_type"/>

                                <field name="os_preference"/>

                                <field name="serial_or_tag"/>

                                <field name="equipment_id"/>

                                <field name="company_id" groups="base.group_multi_company"/>

                            </group>

                        </div>

                    </div>

                    <div class="ew-eol-form-card ew-eol-form-card--ack">

                        <h3 class="ew-eol-form-card__title">

                            <i class="fa fa-check-square-o" title="Acknowledgements"/> Policy acknowledgements

                        </h3>

                        <group col="2">

                            <field name="ack_quantity_limit" readonly="1"/>

                            <field name="ack_as_is" readonly="1"/>

                            <field name="ack_no_support" readonly="1"/>

                            <field name="ack_data_software" readonly="1"/>

                            <field name="ack_final_agreement" readonly="1"/>

                            <field name="ack_policy" readonly="1"/>

                            <field name="ack_policy_version" readonly="1"/>

                        </group>

                    </div>

                    <notebook class="ew-eol-notebook">

                        <page string="Approvals" name="approvals">

                            <field name="approval_line_ids">

                                <list editable="bottom">

                                    <field name="approver_id"/>

                                    <field name="decision" widget="badge"/>

                                    <field name="comment"/>

                                    <field name="decision_date"/>

                                </list>

                            </field>

                        </page>

                        <page string="Verification" name="verification">

                            <field name="verification_id" readonly="1"/>

                        </page>

                    </notebook>

                </sheet>

                <chatter/>

            </form>

        </field>

    </record>



    <record id="eol_purchase_request_view_search" model="ir.ui.view">

        <field name="name">ew.eol.purchase.request.search</field>

        <field name="model">ew.eol.purchase.request</field>

        <field name="arch" type="xml">

            <search>

                <field name="name"/>

                <field name="employee_name"/>

                <field name="work_email"/>

                <field name="equipment_id"/>

                <filter string="Awaiting approval" name="awaiting" domain="[('state', '=', 'awaiting_approval')]"/>

                <filter string="Approved" name="approved" domain="[('state', '=', 'approved')]"/>

                <filter string="Received" name="received" domain="[('state', '=', 'received')]"/>

                <filter string="Exception" name="exception" domain="[('state', '=', 'exception')]"/>

                <separator/>

                <filter string="Status" name="group_state" context="{'group_by': 'state'}"/>

                <filter string="Category" name="group_category" context="{'group_by': 'category_id'}"/>

            </search>

        </field>

    </record>



    <record id="eol_purchase_request_action" model="ir.actions.act_window">

        <field name="name">EOL Purchase Requests</field>

        <field name="res_model">ew.eol.purchase.request</field>

        <field name="view_mode">list,form</field>

        <field name="context">{'search_default_awaiting': 0}</field>

    </record>



</odoo>

