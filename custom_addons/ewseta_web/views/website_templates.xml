<!-- Branded search modal -->
<template id="ewseta_header_search_modal" inherit_id="website.header_search_box" name="EWSETA Search Modal" priority="25">
    <xpath expr="//div[@id='o_search_modal']" position="attributes">
        <attribute name="class" add="ewseta-search-modal" separator=" "/>
    </xpath>
    <xpath expr="//div[@id='o_search_modal']//div[hasclass('modal-content')]" position="attributes">
        <attribute name="class" add="ewseta-search-modal-content" separator=" "/>
    </xpath>
</template>

<!-- Orange header Contact Us button -->
<template id="ewseta_header_cta" inherit_id="website.header_call_to_action" name="EWSETA Header CTA" priority="20">
    <xpath expr="//a[hasclass('btn_cta')]" position="attributes">
        <attribute name="class" add="btn-ewseta-primary" separator=" "/>
    </xpath>
</template>

<!-- Visible mobile menu toggle -->
<template id="ewseta_mobile_menu_toggle" inherit_id="website.template_header_mobile" name="EWSETA Mobile Menu Toggle" priority="30">
    <xpath expr="//button[@data-bs-target='#top_menu_collapse_mobile']" position="attributes">
        <attribute name="class" add="ewseta-mobile-menu-toggle" separator=" "/>
    </xpath>
    <xpath expr="//button[@data-bs-target='#top_menu_collapse_mobile']/span[hasclass('navbar-toggler-icon')]" position="replace">
        <i class="fa fa-bars ewseta-mobile-menu-icon" aria-hidden="true"/>
    </xpath>
</template>

<template id="ewseta_footer_copyright" inherit_id="website.layout" name="EWSETA Footer Copyright" priority="20">
    <xpath expr="//div[hasclass('o_footer_copyright')]//span[hasclass('o_footer_copyright_name')]" position="replace">
        <span class="o_footer_copyright_name">Copyright © 2025 EWSETA | All Rights Reserved</span>
    </xpath>
</template>

<!-- Theme init: light, dark, blue, green, or orange — before paint to avoid flash -->
<template id="ewseta_dark_mode_init" inherit_id="website.layout" name="EWSETA Dark Mode Init" priority="30">
    <xpath expr="//head" position="inside">
        <script id="ewseta-theme-init" type="text/javascript">
            (function () {
                try {
                    var stored = localStorage.getItem('ewseta-theme');
                    if (stored === 'dark') {
                        document.documentElement.classList.add('ewseta-dark-mode');
                        document.documentElement.dataset.ewsetaTheme = 'dark';
                    } else if (stored === 'blue') {
                        document.documentElement.classList.add('ewseta-blue-mode');
                        document.documentElement.dataset.ewsetaTheme = 'blue';
                    } else if (stored === 'green') {
                        document.documentElement.classList.add('ewseta-green-mode');
                        document.documentElement.dataset.ewsetaTheme = 'green';
                    } else if (stored === 'orange') {
                        document.documentElement.classList.add('ewseta-orange-mode');
                        document.documentElement.dataset.ewsetaTheme = 'orange';
                    } else if (!stored &amp;&amp; window.matchMedia('(prefers-color-scheme: dark)').matches) {
                        document.documentElement.classList.add('ewseta-dark-mode');
                        document.documentElement.dataset.ewsetaTheme = 'dark';
                    }
                } catch (e) {}
            })();
        </script>
    </xpath>
</template>

<template id="ewseta_dark_mode_toggle_button" name="EWSETA Theme Toggle">
    <li class="nav-item o_not_editable ewseta-theme-toggle-item">
        <button type="button"
                class="ewseta-theme-toggle o_not_editable"
                aria-label="Cycle theme: light, dark, blue, green, orange"
                title="Cycle theme: light, dark, blue, green, orange">
            <i class="fa fa-moon-o ewseta-theme-icon ewseta-theme-icon-next-dark" aria-hidden="true"/>
            <i class="fa fa-tint ewseta-theme-icon ewseta-theme-icon-next-blue" aria-hidden="true"/>
            <i class="fa fa-leaf ewseta-theme-icon ewseta-theme-icon-next-green" aria-hidden="true"/>
            <i class="fa fa-fire ewseta-theme-icon ewseta-theme-icon-next-orange" aria-hidden="true"/>
            <i class="fa fa-sun-o ewseta-theme-icon ewseta-theme-icon-next-light" aria-hidden="true"/>
        </button>
    </li>
</template>

<template id="ewseta_dark_mode_toggle_desktop" inherit_id="website.template_header_default" name="EWSETA Dark Mode Toggle Desktop" priority="35">
    <xpath expr="//t[@t-call='website.placeholder_header_search_box'][@_layout.f='modal']" position="before">
        <t t-call="ewseta_web.ewseta_dark_mode_toggle_button"/>
    </xpath>
</template>

<template id="ewseta_dark_mode_toggle_mobile" inherit_id="website.template_header_mobile" name="EWSETA Dark Mode Toggle Mobile" priority="35">
    <xpath expr="//ul[hasclass('o_header_mobile_buttons_wrap')]" position="inside">
        <t t-call="ewseta_web.ewseta_dark_mode_toggle_button"/>
    </xpath>
</template>

</odoo>
