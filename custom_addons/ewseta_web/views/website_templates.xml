<?xml version="1.0" encoding="utf-8"?>
<odoo>

<!--
  Odoo QWeb Template Inheritance EXPLAINED:

  <template> tag attributes:
    - id            : Unique technical identifier within your module. Used to reference, extend, or override this template elsewhere.
    - inherit_id    : (optional) Set this to the id of a parent template you want to modify/extend. 
                      If inherit_id is present, this template will *not* render by itself—instead, it describes *modifications* to another template.
    - name          : Human-readable name of the template. Used in backend UIs or website options menus.
    - priority      : Inherited templates are processed in order of priority (largest first). 
                      Higher-priority templates apply their changes before lower ones. Default is usually 16 or 20.

  <xpath> tag: This is ONLY valid in templates WITH inherit_id. Each <xpath> describes a change to apply inside the parent template:
    - expr         : An XPath expression (mini-query language for XML trees), selects one or more nodes inside the parent template.
                     Example: //header       = selects all <header> tags regardless of nesting
                              //header[@id='top']   = selects <header> only where id="top"
    - position     : What to do with the nodes matched by expr. Options:
                     - "before"     : Insert your content just before those nodes.
                     - "after"      : Insert your content just after those nodes.
                     - "replace"    : Replace those nodes with your content.
                     - "attributes" : Change attributes of those nodes (without replacing their whole content).

  Example below:
  - This template extends (inherits) "website.layout" (the main website layout).
  - It PREPENDS a custom topbar <div> before every <header> in that layout.
  - It ADDS a class ("ewseta-header-nav") to the <header id="top"> element.
-->
<template id="ewseta_topbar" inherit_id="website.layout" name="EWSETA Top Bar" priority="20">
    <xpath expr="//header" position="before">
        <div class="ewseta-topbar">
            <div class="container">
                <div class="ewseta-topbar-inner">
                    <div class="ewseta-topbar-left">
                        <span class="ewseta-topbar-item ewseta-topbar-hotline">
                            <span class="ewseta-topbar-icon"><i class="fa fa-phone"/></span>
                            <span class="ewseta-topbar-label">Fraud Hotline</span>
                            <a href="tel:0800611205" class="ewseta-topbar-chip">0800 611 205</a>
                            <span class="ewseta-topbar-meta">Toll Free</span>
                        </span>
                        <a href="mailto:ewseta@thehotline.co.za" class="ewseta-topbar-item ewseta-topbar-link" aria-label="Email ewseta@thehotline.co.za">
                            <span class="ewseta-topbar-icon"><i class="fa fa-envelope"/></span>
                            <span class="ewseta-topbar-link-text">ewseta@thehotline.co.za</span>
                        </a>
                        <a href="/contactus" class="ewseta-topbar-item ewseta-topbar-link" aria-label="Contact Us">
                            <span class="ewseta-topbar-icon"><i class="fa fa-comments"/></span>
                            <span class="ewseta-topbar-link-text">Contact Us</span>
                        </a>
                        <a href="#" class="ewseta-topbar-item ewseta-topbar-link" aria-label="EWSETA Vacancies">
                            <span class="ewseta-topbar-icon"><i class="fa fa-briefcase"/></span>
                            <span class="ewseta-topbar-link-text">EWSETA Vacancies</span>
                        </a>
                        <div class="dropdown ewseta-topbar-hours">
                            <a href="#" class="ewseta-topbar-item ewseta-topbar-link dropdown-toggle" role="button" data-bs-toggle="dropdown" aria-expanded="false" aria-label="Opening Hours">
                                <span class="ewseta-topbar-icon"><i class="fa fa-clock-o"/></span>
                                <span class="ewseta-topbar-link-text">Opening Hours</span>
                            </a>
                            <div class="dropdown-menu ewseta-topbar-hours-menu">
                                <h6 class="dropdown-header">Head Office</h6>
                                <p class="ewseta-hours-address dropdown-item-text">22 Wellington Road, Parktown, Johannesburg</p>
                                <div class="dropdown-divider"/>
                                <div class="ewseta-hours-row">
                                    <span class="day">Monday – Friday</span>
                                    <span class="time">8:00 AM – 4:30 PM</span>
                                </div>
                                <div class="ewseta-hours-row">
                                    <span class="day">Saturday</span>
                                    <span class="time ewseta-hours-closed">Closed</span>
                                </div>
                                <div class="ewseta-hours-row">
                                    <span class="day">Sunday</span>
                                    <span class="time ewseta-hours-closed">Closed</span>
                                </div>
                                <div class="dropdown-divider"/>
                                <p class="ewseta-hours-note dropdown-item-text">Closed on public holidays.</p>
                            </div>
                        </div>
                    </div>
                    <div class="ewseta-topbar-socials">
                        <span class="ewseta-topbar-socials-label">Follow us</span>
                        <a href="https://www.facebook.com/ewseta" class="ewseta-social-link" target="_blank" rel="noopener noreferrer" aria-label="Facebook"><i class="fa fa-facebook"/></a>
                        <a href="https://twitter.com/ewseta" class="ewseta-social-link" target="_blank" rel="noopener noreferrer" aria-label="X"><i class="fa fa-twitter"/></a>
                        <a href="https://www.instagram.com/ewseta" class="ewseta-social-link" target="_blank" rel="noopener noreferrer" aria-label="Instagram"><i class="fa fa-instagram"/></a>
                        <a href="https://www.linkedin.com/company/ewseta" class="ewseta-social-link" target="_blank" rel="noopener noreferrer" aria-label="LinkedIn"><i class="fa fa-linkedin"/></a>
                        <a href="https://www.youtube.com/ewseta" class="ewseta-social-link" target="_blank" rel="noopener noreferrer" aria-label="YouTube"><i class="fa fa-youtube-play"/></a>
                    </div>
                </div>
            </div>
        </div>
    </xpath>
    <xpath expr="//header[@id='top']" position="attributes">
        <attribute name="t-attf-class" add="ewseta-header-nav" separator=" "/>
    </xpath>
</template>

<!-- EWSETA logo -->
<template id="ewseta_header_brand" inherit_id="website.option_header_brand_logo" name="EWSETA Header Logo" priority="20">
    <xpath expr="//a[@data-name='Navbar Logo']/span[@t-field='website.logo']" position="replace">
        <img src="/ewseta_web/static/img/ewseta_logo.png" alt="Energy &amp; Water SETA" width="220" height="55"/>
    </xpath>
</template>

