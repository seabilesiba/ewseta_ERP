<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <record id="module_category_ewseta_proc" model="ir.module.category">
    <field name="name">EWSETA Procurement</field>
    <field name="sequence">1</field>
  </record>

  <record model="res.groups.privilege" id="res_groups_privilege_ewseta_procurement">
    <field name="name">EWSETA Procurement</field>
    <field name="category_id" ref="module_category_ewseta_proc"/>
  </record>

  <record id="group_scm_owner" model="res.groups">
    <field name="name">SCM Owner</field>
    <field name="sequence">10</field>
    <field name="privilege_id" ref="res_groups_privilege_ewseta_procurement"/>
    <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
  </record>

  <record id="group_service_provider" model="res.groups">
    <field name="name">Service Provider</field>
    <field name="sequence">20</field>
    <field name="privilege_id" ref="res_groups_privilege_ewseta_procurement"/>
    <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
  </record>

  <record id="group_rfq_admin" model="res.groups">
    <field name="name">Procurement Admin</field>
    <field name="sequence">30</field>
    <field name="privilege_id" ref="res_groups_privilege_ewseta_procurement"/>
    <field name="implied_ids" eval="[(4, ref('group_scm_owner')), (4, ref('proc_cms.group_proc_cms_manager'))]"/>
    <field name="user_ids" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
  </record>
</odoo>
