<?xml version="1.0" encoding="utf-8"?>

<odoo>



    <!-- Root menu for SCM & Procurement Admin (not service providers) -->

    <menuitem id="menu_ew_root"

              name="EWSETA Procurement"

              sequence="2"

              groups="ewseta_procurement.group_scm_owner,ewseta_procurement.group_rfq_admin"/>



    <menuitem id="menu_ew_rfq_admin"

              name="RFQs/RFPs Admin"

              parent="menu_ew_root"

              action="action_ew_rfq_admin"

              sequence="2"

              groups="ewseta_procurement.group_rfq_admin"/>



    <menuitem id="menu_ew_rfq"

              name="RFQs/RFPs"

              parent="menu_ew_root"

              action="action_ew_rfq"

              sequence="5"

              groups="ewseta_procurement.group_scm_owner"/>



    <menuitem id="menu_ew_submission_scm"

              name="Submissions"

              parent="menu_ew_root"

              action="ewseta_procurement.action_ew_submission_unlocked"

              sequence="20"

              groups="ewseta_procurement.group_rfq_admin,ewseta_procurement.group_scm_owner"/>



    <menuitem id="menu_ew_submission_provider_all"

              name="All Submissions"

              parent="menu_ew_root"

              action="ewseta_procurement.action_ew_submission_all"

              sequence="10"

              groups="ewseta_procurement.group_rfq_admin"/>



    <!-- Dedicated app root for service providers only -->

    <menuitem id="menu_ew_sp_root"

              name="EWSETA Procurement"

              sequence="2"

              groups="ewseta_procurement.group_service_provider"/>



    <menuitem id="menu_ew_rfq_provider_transversal"

              name="Transversal RFQs/RFPs"

              parent="menu_ew_sp_root"

              action="ewseta_procurement.action_ew_rfq_provider_transversal"

              sequence="1"

              groups="ewseta_procurement.group_service_provider"/>



    <menuitem id="menu_ew_submission_provider"

              name="My transversal applications"

              parent="menu_ew_sp_root"

              action="ewseta_procurement.action_ew_submission_provider_sp"

              sequence="2"

              groups="ewseta_procurement.group_service_provider"/>



</odoo>

