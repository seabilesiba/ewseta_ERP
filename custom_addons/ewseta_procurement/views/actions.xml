<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="action_ew_rfq_provider_transversal" model="ir.actions.act_window">
        <field name="name">Transversal RFQs/RFPs</field>
        <field name="res_model">ew.rfq</field>
        <field name="view_mode">list,form</field>
        <field name="view_ids" eval="[Command.clear(),
                          (0, 0, {'view_mode': 'list', 'view_id': ref('view_ew_rfq_provider_tree')}),
                          (0, 0, {'view_mode': 'form', 'view_id': ref('view_ew_rfq_provider_form')})]"/>
        <field name="domain">[('state', '=', 'published'), ('is_past_closing', '=', False), ('publication_type', '=', 'transversal')]</field>
        <field name="context">{'ewseta_provider_transversal': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Transversal opportunities matching your profile appear here after EWSETA publishes them.
            </p>
        </field>
    </record>

    <record id="action_ew_submission_provider_v2" model="ir.actions.act_window">
        <field name="name">My Submissions</field>
        <field name="res_model">ew.submission</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[]</field>
        <field name="context">{'search_default_groupby_rfq': 0}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create a submission for an open RFQ/RFP, upload your documents, then click Submit.
            </p>
        </field>
    </record>

    <record id="action_ew_submission_provider_sp" model="ir.actions.act_window">
        <field name="name">My transversal applications</field>
        <field name="res_model">ew.submission</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('rfq_publication_type', '=', 'transversal')]</field>
        <field name="context">{'search_default_groupby_rfq': 0}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Open a transversal RFQ/RFP, click Apply, upload documents, then Submit.
            </p>
        </field>
    </record>


    <record id="action_ew_submission_unlocked" model="ir.actions.act_window">
        <field name="name">Submissions</field>
        <field name="res_model">ew.submission</field>
        <field name="view_mode">list,form</field>
        <field name="domain">['|', ('rfq_id.unlocked', '=', True), ('rfq_id.state', '=', 'closed')]</field>
         <field name="context">{'search_default_groupby_rfq': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Submissions will appear once your RFQs reach their closing date.
            </p>
        </field>
    </record>


    <record id="action_ew_submission_line_preview" model="ir.actions.act_window">
        <field name="name">Document preview</field>
        <field name="res_model">ew.submission.line.preview</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="ewseta_procurement.view_ew_submission_line_preview_form"/>
        <field name="target">new</field>
        <field name="context">{'dialog_size': 'extra-large'}</field>
    </record>

    <record id="action_ew_submission_all" model="ir.actions.act_window">
        <field name="name">Submissions</field>
        <field name="res_model">ew.submission</field>
        <field name="view_mode">list,form</field>
        <!-- default group by RFQ -->
        <field name="context">{'search_default_groupby_rfq': 1}</field>
        <field name="search_view_id" ref="ewseta_procurement.view_ew_submission_search"/>
    </record>




</odoo>


