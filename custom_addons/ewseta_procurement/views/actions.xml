<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="action_ew_submission_provider_v2" model="ir.actions.act_window">
        <field name="name">My Submissions</field>
        <field name="res_model">ew.submission</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[]</field>
        <field name="context">{'search_default_groupby_rfq': 0}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create a submission for an open RFQ/RFP, upload your documents, then click Submit.
            </p>
        </field>
    </record>


    <record id="action_ew_submission_unlocked" model="ir.actions.act_window">
        <field name="name">Submissions</field>
        <field name="res_model">ew.submission</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('rfq_id.unlocked','=',True)]</field>
         <field name="context">{'search_default_groupby_rfq': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Submissions will appear once your RFQs reach their closing date.
            </p>
        </field>
    </record>


    <record id="action_ew_submission_all" model="ir.actions.act_window">
        <field name="name">Submissions</field>
        <field name="res_model">ew.submission</field>
        <field name="view_mode">list,form</field>
        <!-- default group by RFQ -->
        <field name="context">{'search_default_groupby_rfq': 1}</field>
        <field name="search_view_id" ref="ewseta_procurement.view_ew_submission_search"/>
    </record>




</odoo>


