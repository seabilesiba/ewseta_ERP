<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_ew_briefing_attendance_search" model="ir.ui.view">
        <field name="name">ew.rfq.briefing.attendance.search</field>
        <field name="model">ew.rfq.briefing.attendance</field>
        <field name="arch" type="xml">
            <search>
                <field name="company_name"/>
                <field name="contact_email"/>
                <field name="contact_name"/>
                <field name="rfq_id"/>
                <filter string="Portal" name="source_portal" domain="[('source', '=', 'portal')]"/>
                <filter string="Service provider (backend)" name="source_sp_backend" domain="[('source', '=', 'sp_backend')]"/>
                <filter string="SCM manual" name="source_scm" domain="[('source', '=', 'scm_manual')]"/>
                <filter string="Virtual" name="mode_virtual" domain="[('mode', '=', 'virtual')]"/>
                <filter string="On-site" name="mode_contact" domain="[('mode', '=', 'contact')]"/>
                <separator/>
                <filter string="RFQ / RFP" name="group_rfq" context="{'group_by': 'rfq_id'}"/>
                <filter string="Source" name="group_source" context="{'group_by': 'source'}"/>
                <filter string="Format" name="group_mode" context="{'group_by': 'mode'}"/>
            </search>
        </field>
    </record>

    <record id="view_ew_briefing_attendance_tree" model="ir.ui.view">
        <field name="name">ew.rfq.briefing.attendance.list</field>
        <field name="model">ew.rfq.briefing.attendance</field>
        <field name="priority">16</field>
        <field name="arch" type="xml">
            <list string="Briefing attendance"
                  class="ew-proc-briefing-att-list"
                  default_order="attended_at desc">
                <field name="attended_at"/>
                <field name="rfq_id" string="RFQ / RFP"/>
                <field name="company_name"/>
                <field name="contact_name" optional="show"/>
                <field name="contact_email"/>
                <field name="contact_phone" optional="hide"/>
                <field name="mode" widget="badge"
                       decoration-info="mode == 'virtual'"
                       decoration-success="mode == 'contact'"/>
                <field name="source" widget="badge"
                       decoration-success="source in ('portal', 'sp_backend')"
                       decoration-warning="source == 'scm_manual'"/>
                <field name="registered_by" widget="many2one_avatar_user" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="view_ew_briefing_attendance_form" model="ir.ui.view">
        <field name="name">ew.rfq.briefing.attendance.form</field>
        <field name="model">ew.rfq.briefing.attendance</field>
        <field name="priority">16</field>
        <field name="arch" type="xml">
            <form string="Briefing attendance" class="ew-proc-briefing-att-form">
                <sheet>
                    <field name="proof_token" invisible="1"/>

                    <div class="oe_title ew-proc-form-title">
                        <h1>
                            <field name="company_name" placeholder="Company / supplier name"/>
                        </h1>
                        <p class="ew-proc-briefing-att-form__subtitle text-muted mb-0">
                            Briefing session attendance
                        </p>
                    </div>

                    <div class="ew-proc-form-hero ew-proc-briefing-att-form__hero">
                        <div class="ew-proc-form-hero__main">
                            <span class="ew-proc-form-label">RFQ / RFP</span>
                            <field name="rfq_id" readonly="1" class="ew-proc-form-ref ew-proc-briefing-att-form__rfq"/>
                        </div>
                        <div class="ew-proc-briefing-att-form__badges d-flex flex-wrap gap-2 align-items-center">
                            <field name="mode" widget="badge"
                                   decoration-info="mode == 'virtual'"
                                   decoration-success="mode == 'contact'"/>
                            <field name="source" widget="badge"
                                   decoration-success="source in ('portal', 'sp_backend')"
                                   decoration-warning="source == 'scm_manual'"/>
                        </div>
                    </div>

                    <div class="ew-proc-form-grid">
                        <div class="ew-proc-form-card">
                            <div class="ew-proc-form-card__head">Contact</div>
                            <group colspan="2" class="ew-proc-form-card-group">
                                <group colspan="2">
                                    <field name="contact_name"/>
                                    <field name="contact_email" widget="email"/>
                                    <field name="contact_phone" widget="phone"/>
                                    <field name="partner_id"/>
                                </group>
                            </group>
                        </div>
                        <div class="ew-proc-form-card">
                            <div class="ew-proc-form-card__head">Registration</div>
                            <group colspan="2" class="ew-proc-form-card-group">
                                <group colspan="2">
                                    <field name="attended_at"/>
                                    <field name="registered_by" readonly="1"/>
                                </group>
                            </group>
                        </div>
                    </div>

                    <div class="ew-proc-form-card ew-proc-form-card--wide ew-proc-briefing-att-form__proof"
                         invisible="not portal_proof_url">
                        <div class="ew-proc-form-card__head">Supplier portal proof</div>
                        <p class="ew-proc-form-hint mb-2">
                            Link the supplier received after registering on the portal (portal registrations only).
                        </p>
                        <field name="portal_proof_url" widget="url" readonly="1" nolabel="1"/>
                    </div>

                    <div class="ew-proc-form-card ew-proc-form-card--wide">
                        <div class="ew-proc-form-card__head">Internal notes</div>
                        <field name="notes" placeholder="Optional SCM notes…" nolabel="1"/>
                    </div>
                </sheet>
            </form>
        </field>
    </record>

</odoo>
