<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_ew_service_category_list" model="ir.ui.view">
        <field name="name">ew.service.category.list</field>
        <field name="model">ew.service.category</field>
        <field name="arch" type="xml">
            <list>
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="active" widget="boolean_toggle"/>
            </list>
        </field>
    </record>

    <record id="view_ew_service_category_form" model="ir.ui.view">
        <field name="name">ew.service.category.form</field>
        <field name="model">ew.service.category</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="sequence"/>
                        <field name="active"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_ew_service_category" model="ir.actions.act_window">
        <field name="name">Service categories</field>
        <field name="res_model">ew.service.category</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
