<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="mail_tmpl_briefing_session_start" model="mail.template">
        <field name="name">RFQ: briefing session started</field>
        <field name="model_id" ref="model_ew_rfq"/>
        <field name="subject">EWSETA briefing session started — {{ object.reference }} {{ object.name }}</field>
        <field name="email_from">{{ (user.company_id.email_formatted or user.email_formatted) }}</field>
        <field name="auto_delete" eval="True"/>
        <field name="body_html" type="html">
<div style="font-family: Arial, sans-serif; line-height: 1.5; color: #333;">
    <p>Hello <t t-out="ctx.get('recipient_name') or 'Supplier'"/>,</p>
    <p>The briefing session for <strong><t t-out="object.name"/></strong>
       (ref: <t t-out="object.reference"/>) has started.</p>
    <p>
        <strong>Session time:</strong>
        <t t-out="ctx.get('briefing_start_display')"/> –
        <t t-out="ctx.get('briefing_end_display')"/>
    </p>
    <t t-if="object.briefing_mode == 'virtual'">
        <p><strong>Join online (virtual briefing):</strong></p>
        <p>
            <a t-att-href="object.briefing_virtual_link"><t t-out="object.briefing_virtual_link"/></a>
        </p>
        <p class="text-muted">The same join link appears on your application form while the session is live.</p>
    </t>
    <t t-if="object.briefing_mode == 'contact'">
        <p><strong>Venue (on-site briefing):</strong></p>
        <p t-out="object.briefing_location"/>
    </t>
    <p t-if="ctx.get('briefing_register_url')">
        <strong>Sign the attendance register</strong> (private link — only for applicants):
        <br/>
        <a t-att-href="ctx.get('briefing_register_url')">Open briefing attendance register</a>
    </p>
    <p t-if="ctx.get('briefing_apply_url')">
        Submit your RFQ/RFP application (separate from attendance):
        <br/>
        <a t-att-href="ctx.get('briefing_apply_url')"><t t-out="ctx.get('briefing_apply_url')"/></a>
    </p>
    <p>Kind regards,<br/>EWSETA Supply Chain Management</p>
</div>
        </field>
    </record>

</odoo>
