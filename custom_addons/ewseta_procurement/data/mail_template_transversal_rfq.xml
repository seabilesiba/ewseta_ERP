<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="mail_tmpl_transversal_rfq_published" model="mail.template">
        <field name="name">Transversal RFQ/RFP published (service provider)</field>
        <field name="model_id" ref="model_ew_rfq"/>
        <field name="subject">Transversal opportunity — {{ object.reference }} {{ object.name }}</field>
        <field name="email_from">{{ (user.company_id.email_formatted or user.email_formatted) }}</field>
        <field name="use_default_to" eval="False"/>
        <field name="auto_delete" eval="True"/>
        <field name="body_html" type="html">
<div style="font-family: Arial, sans-serif; line-height: 1.5; color: #333;">
    <p>Hello <t t-out="ctx.get('recipient_name') or 'Service provider'"/>,</p>
    <p>EWSETA published a <strong>transversal</strong> RFQ/RFP that matches your registered service categories and provinces.</p>
    <p><strong><t t-out="object.name"/></strong><br/>
       Reference: <t t-out="object.reference"/><br/>
       Type: <t t-out="(object.type or 'rfq').upper()"/><br/>
       Closes: <t t-out="object.closing_at"/></p>
    <p t-if="ctx.get('transversal_apply_url')">
        Sign in to Odoo, open this opportunity, and click <strong>Apply / open application</strong> to complete your submission (same fields and documents as the public portal):
        <br/>
        <a t-att-href="ctx.get('transversal_apply_url')"><t t-out="ctx.get('transversal_apply_url')"/></a>
    </p>
    <p>This opportunity is not listed on the public procurement website.</p>
    <p>Kind regards,<br/>EWSETA Supply Chain Management</p>
</div>
        </field>
    </record>
</odoo>
